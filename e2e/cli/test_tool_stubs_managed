#!/usr/bin/env bash

# User and system catalogues publish into separate mise-owned bins. User stubs
# shadow system stubs without modifying package-owned files.
export MISE_SYSTEM_CONFIG_DIR="$PWD/system-config"
export MISE_SYSTEM_DATA_DIR="$PWD/system-data"
mkdir -p "$MISE_CONFIG_DIR" "$MISE_SYSTEM_CONFIG_DIR"
cat >"$MISE_SYSTEM_CONFIG_DIR/config.toml" <<'EOF'
[tool_stubs]
dummy-scope = { tool = "dummy", version = "1", bin = "dummy" }
EOF
cat >"$MISE_CONFIG_DIR/config.toml" <<'EOF'
[tool_stubs]
dummy-scope = { tool = "dummy", version = "2", bin = "dummy" }
EOF

# Project config cannot publish commands into a shared user or system bin.
mkdir project-catalogue
cat >project-catalogue/mise.toml <<'EOF'
[tool_stubs]
project-command = "dummy@2"
EOF
assert_fail_contains "cd project-catalogue && mise tool-stub status 2>&1" "[tool_stubs] is only supported in system and global config files"

# Activation publishes both managed bins before they exist so a later sync is
# immediately visible in the already-activated shell.
assert_fail "test -d '$MISE_SYSTEM_DATA_DIR/tool-stubs/bin'"
assert_fail "test -d '$MISE_DATA_DIR/tool-stubs/bin'"
assert_contains "mise activate bash --no-hook-env" "$MISE_SYSTEM_DATA_DIR/tool-stubs/bin"
assert_contains "mise activate bash --no-hook-env" "$MISE_DATA_DIR/tool-stubs/bin"
eval "$(mise activate bash --no-hook-env)"
mise tool-stub sync --system
mise tool-stub sync
assert "test -x '$MISE_SYSTEM_DATA_DIR/tool-stubs/bin/dummy-scope'"
assert "test -x '$MISE_DATA_DIR/tool-stubs/bin/dummy-scope'"
assert_contains "mise tool-stub status --system" "current"
assert_contains "mise tool-stub status" "current"
assert_contains "PATH='$MISE_DATA_DIR/tool-stubs/bin:$MISE_SYSTEM_DATA_DIR/tool-stubs/bin:$PATH' dummy-scope" "This is Dummy 2.0.0"
assert_contains "PATH='$MISE_SYSTEM_DATA_DIR/tool-stubs/bin:$PATH' dummy-scope" "This is Dummy 1.1.0"
assert_contains "dummy-scope" "This is Dummy 2.0.0"

# Clearing the last declaration reconciles away previously managed stubs.
printf '[settings]\n' >"$MISE_CONFIG_DIR/config.toml"
mise tool-stub sync
assert_fail "test -e '$MISE_DATA_DIR/tool-stubs/bin/dummy-scope'"
assert "mise tool-stub status --missing" ""

mkdir -p "$MISE_DATA_DIR/shims"
cat >check-shim-precedence.sh <<'EOF'
eval "$(mise activate bash --shims)"
test "${PATH%%:*}" = "$MISE_DATA_DIR/shims"
EOF
assert "PATH='$MISE_DATA_DIR/shims:$PATH' bash check-shim-precedence.sh"
mise uninstall dummy@1.1.0
mise install dummy@1.0.0
assert_contains "mise tool-stub upgrade --system --dry-run" "Would install dummy@1.1.0"
mise tool-stub remove
mise tool-stub remove --system
mise uninstall dummy --all

mkdir -p managed-stubs/bin
cd managed-stubs

cat >stubs.toml <<'EOF'
[commands]
dummy-one = { tool = "dummy", version = "1", bin = "dummy" }
EOF

# Sync writes an executable stub but preserves lazy installation.
mise tool-stub sync stubs.toml --into ./bin
assert "test -x bin/dummy-one"
assert_contains "cat bin/dummy-one" "managed by mise tool-stubs bundle"
assert_contains "mise tool-stub status stubs.toml" "current"
assert_not_contains "mise ls --installed dummy" "1.1.0"
assert_contains "./bin/dummy-one" "This is Dummy 1.1.0"

# Manifest changes are stale, while edits to generated files are modified.
sed -i 's/version = "1"/version = "2"/' stubs.toml
assert_contains "mise tool-stub status stubs.toml" "stale"
mise tool-stub sync stubs.toml
assert_contains "cat bin/dummy-one" 'version = "2"'

printf '\n# local edit\n' >>bin/dummy-one
assert_contains "mise tool-stub status stubs.toml" "modified"
assert_fail "mise tool-stub sync stubs.toml"
mise tool-stub sync stubs.toml --force
assert_not_contains "cat bin/dummy-one" "local edit"
assert_contains "./bin/dummy-one" "This is Dummy 2.0.0"

# Unowned files, including native binaries, are collisions and are not
# overwritten without an explicit force.
printf '\377\376\000' >bin/collision
chmod +x bin/collision
cat >stubs.toml <<'EOF'
[commands]
dummy-one = { tool = "dummy", version = "2", bin = "dummy" }
collision = { tool = "dummy", version = "2", bin = "dummy" }
EOF
assert_contains "mise tool-stub status stubs.toml" "conflict"
assert_fail "mise tool-stub sync stubs.toml"
assert_contains "od -An -tx1 bin/collision" "ff fe 00"
mise tool-stub sync stubs.toml --force
assert_contains "cat bin/collision" "managed by mise tool-stubs bundle"

# Commands removed from the manifest are removed only when still owned.
cat >stubs.toml <<'EOF'
[commands]
dummy-one = { tool = "dummy", version = "2", bin = "dummy" }
EOF
mise tool-stub sync stubs.toml
assert_fail "test -e bin/collision"

# A failure after reconciliation starts restores the complete old catalogue.
cat >stubs.toml <<'EOF'
[commands]
aa-rollback-old = { tool = "dummy", version = "2", bin = "dummy" }
dummy-one = { tool = "dummy", version = "2", bin = "dummy" }
EOF
mise tool-stub sync stubs.toml
cat >stubs.toml <<'EOF'
[commands]
dummy-one = { tool = "dummy", version = "2", bin = "dummy" }
zz-rollback-blocked = { tool = "dummy", version = "2", bin = "dummy" }
EOF
mkdir bin/zz-rollback-blocked
assert_fail "mise tool-stub sync stubs.toml --force"
assert "test -x bin/aa-rollback-old"
rmdir bin/zz-rollback-blocked
cat >stubs.toml <<'EOF'
[commands]
aa-rollback-old = { tool = "dummy", version = "2", bin = "dummy" }
dummy-one = { tool = "dummy", version = "2", bin = "dummy" }
EOF
assert_contains "mise tool-stub status stubs.toml" "current   aa-rollback-old"
cat >stubs.toml <<'EOF'
[commands]
dummy-one = { tool = "dummy", version = "2", bin = "dummy" }
EOF
mise tool-stub sync stubs.toml
assert_fail "test -e bin/aa-rollback-old"

# Stale reconciliation and removal preserve commands currently owned by a
# different bundle sharing the destination, even under --force.
mkdir shared-bin
cat >bundle-a.toml <<'EOF'
[commands]
shared-command = { tool = "dummy", version = "1", bin = "dummy" }
EOF
cat >bundle-b.toml <<'EOF'
[commands]
shared-command = { tool = "dummy", version = "2", bin = "dummy" }
EOF
mise tool-stub sync bundle-a.toml --into ./shared-bin
mise tool-stub sync bundle-b.toml --into ./shared-bin --force
printf '[commands]\n' >bundle-a.toml
mise tool-stub sync bundle-a.toml --into ./shared-bin --force
assert_contains "mise tool-stub status bundle-b.toml --into ./shared-bin" "current   shared-command"

cat >bundle-a.toml <<'EOF'
[commands]
shared-command = { tool = "dummy", version = "1", bin = "dummy" }
EOF
mise tool-stub sync bundle-a.toml --into ./shared-bin --force
mise tool-stub sync bundle-b.toml --into ./shared-bin --force
mise tool-stub remove bundle-a.toml --into ./shared-bin --force
assert_contains "mise tool-stub status bundle-b.toml --into ./shared-bin" "current   shared-command"
mise tool-stub remove bundle-b.toml --into ./shared-bin

# --missing is concise enough for provisioning scripts.
rm bin/dummy-one
assert "mise tool-stub status stubs.toml --missing" "dummy-one"
mise tool-stub sync stubs.toml

# Removal protects edits and never uninstalls tools.
printf '\n# keep me\n' >>bin/dummy-one
assert_fail "mise tool-stub remove stubs.toml"
mise tool-stub remove stubs.toml --force
assert_fail "test -e bin/dummy-one"
assert_contains "mise ls --installed dummy" "2.0.0"

# Upgrade acts only on already-installed versions selected by stubs.
mise uninstall dummy --all
cat >stubs.toml <<'EOF'
[commands]
dummy-one = { tool = "dummy", version = "1", bin = "dummy" }
EOF
mise tool-stub sync stubs.toml --into ./bin
mise install dummy@1.0.0
assert_contains "mise tool-stub upgrade stubs.toml --dry-run" "Would install dummy@1.1.0"
mise tool-stub upgrade stubs.toml --no-prune
assert_contains "mise ls --installed dummy" "1.1.0"
assert_contains "mise ls --installed dummy" "1.0.0"

# The top-level upgrade flag covers every tracked stub as well.
mise uninstall dummy@1.1.0
# One repurposed tracked path must not block the remaining valid stubs.
printf 'not a tool stub\n' >bad-stub
mkdir -p "$MISE_STATE_DIR/tracked-stubs"
ln -s "$PWD/bad-stub" "$MISE_STATE_DIR/tracked-stubs/bad-stub"
assert_fail_contains "mise upgrade --tool-stubs --dry-run-code --no-prune 2>&1" "Would install dummy@1.1.0"
mise upgrade --tool-stubs --no-prune
assert_contains "mise ls --installed dummy" "1.1.0"

# Immediate pruning reconciles aliases that pointed at the replaced version.
mise uninstall dummy@1.1.0
ln -s ./1.0.0 "$MISE_DATA_DIR/installs/dummy/retired-stub"
mise tool-stub upgrade stubs.toml --prune
assert_not_contains "mise ls --installed dummy" "1.0.0"
assert_fail "test -L '$MISE_DATA_DIR/installs/dummy/retired-stub'"

mise tool-stub remove stubs.toml
rm -f stubs.toml
